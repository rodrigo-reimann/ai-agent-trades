# Copy this file to .env and fill in what you need.

# Claude (used from Milestone 3)
ANTHROPIC_API_KEY=
# claude-haiku-5-5 (fast, cheap) or claude-sonnet-5-5 (smarter)
CLAUDE_MODEL=claude-haiku-5-5

# Which calendar to use: fake (JSON file) | google (Milestone 7)
CALENDAR_PROVIDER=fake

# Where local data lives
DB_PATH=data/homeconfirm.db
FAKE_CALENDAR_PATH=data/fake_calendar.json
